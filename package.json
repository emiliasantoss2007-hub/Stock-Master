{
  "name": "stock-master",
  "version": "1.0.0",
  "description": "Sistema web de gerenciamento de estoque desenvolvido para uma assistência técnica, com foco na organização dos produtos e no controle das movimentações de estoque.",
  "main": "server.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "start": "node server.js",
    "test": "jest",
    "test:e2e": "playwright test --config=playwright.config.js",
    "test:e2e:ui": "playwright test --config=playwright.config.js --ui",
    "e2e:prepare-db": "node scripts/e2e/prepare-db.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emiliasantoss2007-hub/Stock-Master.git"
  },
