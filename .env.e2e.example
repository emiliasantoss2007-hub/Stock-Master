# Copie este arquivo para .env.e2e e ajuste apenas a conexão local do MySQL.
# O banco é verificado pelo nome exato antes de iniciar o servidor ou o preparo.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=stockmaster_test
DB_PORT=3306
PORT=3002
E2E_EXPECTED_DB=stockmaster_test

# Contas fictícias locais criadas por `npm run e2e:prepare-db`.
E2E_ADMIN_LOGIN=e2e.admin
E2E_ADMIN_PASSWORD=E2e-Admin-Local-2026!
E2E_TECH_LOGIN=e2e.tecnico
E2E_TECH_PASSWORD=E2e-Tecnico-Local-2026!
